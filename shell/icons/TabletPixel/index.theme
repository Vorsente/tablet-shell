[Icon Theme]
Name=Tablet Pixel
Comment=Rounded Material icons for the tablet shell, inherits installed application logos
Inherits=Colloid,Colloid-Dark,Colloid-Light,breeze
FollowsColorScheme=true
Directories=scalable/apps,scalable/actions,apps/scalable,symbolic

[scalable/apps]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Applications

[scalable/actions]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Actions

# round adaptive app icons drawn on the device (tablet-tools app-icons --pixel)
[apps/scalable]
Size=48
Type=Scalable
MinSize=16
MaxSize=512
Context=Applications

# Breeze symbolic icons the shell uses, copied at install (scripts/pixel-symbolic-icons.py)
[symbolic]
Size=16
Type=Scalable
MinSize=8
MaxSize=512
Context=Actions
