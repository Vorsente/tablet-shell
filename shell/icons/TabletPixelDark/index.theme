[Icon Theme]
Name=Tablet Pixel Dark
Comment=Material icons and contrast-aware dark panel symbols
Inherits=TabletPixel,Colloid-Dark,Colloid,breeze
Directories=scalable/actions,symbolic

[scalable/actions]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Actions

# Breeze symbolic icons the shell uses, copied at install (scripts/pixel-symbolic-icons.py)
[symbolic]
Size=16
Type=Scalable
MinSize=8
MaxSize=512
Context=Actions
