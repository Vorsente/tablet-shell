# Pulsing Linux penguin in the middle of a black screen, nothing else.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);

fun layout() {
    w = Window.GetWidth();
    h = Window.GetHeight();
    logo.sprite.SetX(Window.GetX() + w / 2 - logo.image.GetWidth() / 2);
    logo.sprite.SetY(Window.GetY() + h / 2 - logo.image.GetHeight() / 2);
}
layout();

t = 0;
fun refresh() {
    t++;
    # ~2 s breathing cycle at 50 Hz, opacity between 0.25 and 1
    logo.sprite.SetOpacity(0.625 + 0.375 * Math.Cos(t * 0.063));
}
Plymouth.SetRefreshFunction(refresh);

# Nothing else on screen: boot/shutdown messages and prompts are not drawn
fun ignore(text) {}
Plymouth.SetMessageFunction(ignore);
Plymouth.SetUpdateStatusFunction(ignore);
