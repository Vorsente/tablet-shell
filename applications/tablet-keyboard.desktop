[Desktop Entry]
Type=Application
Name=Keyboard
Name[ru]=Клавиатура
Comment=On-screen keyboard (iPad style, en/ru, emoji, split)
Exec=@HOME@/.local/share/tablet-keyboard/tablet-keyboard
Icon=input-keyboard-virtual
NoDisplay=true
X-KDE-Wayland-VirtualKeyboard=true
X-KDE-Wayland-Interfaces=zwp_input_method_v1,zwp_input_panel_v1
