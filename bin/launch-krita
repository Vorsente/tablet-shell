#!/usr/bin/env bash
# Keep Krita optional; the whole tablet shell must still install without it.
if command -v krita >/dev/null 2>&1; then
    exec krita "$@"
fi
if command -v notify-send >/dev/null 2>&1; then
    notify-send -a tablet-shell -i dialog-error 'Krita' 'Установите Krita: sudo pacman -S krita'
else
    echo 'Krita is not installed. Install: sudo pacman -S krita' >&2
fi
exit 1
