#!/usr/bin/env bash
# Keep Krita optional; the whole tablet shell must still install without it.
if command -v krita >/dev/null 2>&1; then
    exec krita "$@"
fi
if command -v notify-send >/dev/null 2>&1; then
    notify-send -a tablet-shell -i dialog-error 'Krita' 'Установите пакет krita (Discover или менеджер пакетов) / Install the krita package'
else
    echo 'Krita is not installed: install the krita package of your distribution.' >&2
fi
exit 1
